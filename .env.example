# ==============================================================================
# U&I Logistics Customer Portal & Admin System - Environment Variables Template
# ==============================================================================
#
# Sao chép file này thành .env (cho local development) hoặc nhập trực tiếp các
# giá trị tương ứng vào Render Dashboard (Environment Variables).
#
# LƯU Ý BẢO MẬT:
# - KHÔNG commit file .env chứa giá trị thật lên Git repository.
# - KHÔNG đặt secrets, tokens admin, passwords vào các biến có tiền tố VITE_*.
# - Các biến tiền tố VITE_* sẽ được nhúng công khai vào mã nguồn Frontend client-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (Render Static Site)
# ------------------------------------------------------------------------------
# URL của máy chủ PocketBase Backend.
# - Local Development: http://127.0.0.1:8090
# - Render Production: https://<your-backend-app-name>.onrender.com
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT CONFIGURATION (Render Web Service - PocketBase)
# ------------------------------------------------------------------------------
# Cổng chạy của máy chủ PocketBase (Render sẽ tự động gán biến PORT).
PORT=8090

# Thư mục lưu trữ database SQLite & File uploads của PocketBase.
# - Mặc định Docker container: /pb/pb_data
# - Khi gắn Persistent Disk: /pb/pb_data
PB_DATA_DIR=/pb/pb_data

# Tài khoản Quản trị viên Tối cao (Superuser Admin) khởi tạo tự động lần đầu (Tùy chọn)
# Nếu cung cấp, entrypoint container sẽ tạo tài khoản admin nếu chưa tồn tại.
PB_ADMIN_EMAIL=admin@demo.local
PB_ADMIN_PASSWORD=Admin@123456
