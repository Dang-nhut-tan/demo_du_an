# CHÚ Ý: Biến có tiền tố VITE_* sẽ xuất hiện trong file JavaScript bundle ở client.
# TUYỆT ĐỐI KHÔNG đặt secret key, database password vào file này.
# ==============================================================================

VITE_POCKETBASE_URL=http://127.0.0.1:8090
